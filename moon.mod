name = "Lfan-ke/moonrpc"

version = "0.3.0"

readme = "README.md"

repository = "https://github.com/Lfan-ke/moonrpc"

license = "Apache-2.0"

keywords = [ "grpc", "rpc", "protobuf", "http2", "moonbit" ]

description = "moonrpc — a real gRPC implementation for MoonBit (← gRPC). v0.3: the self-built HTTP/2 (RFC 7540) frame layer (all ten frame types + connection preface + stream state machine) and complete HPACK (RFC 7541) — static table, integers, Huffman coding (Appendix B), and the dynamic table with eviction, driven by a stateful encoder/decoder — plus the shared length-prefixed framing and 17-code gRPC status model."
